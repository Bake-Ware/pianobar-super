<?xml version="1.0" encoding="utf-8"?>
<!-- One row: small art, title and artist, then the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_art" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:src="@drawable/widget_art_placeholder"
        android:contentDescription="@string/widget_art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFD9E3E1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_station" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFE68B55" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
        <ImageButton android:id="@+id/widget_listen" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/widget_button" android:src="@drawable/ic_widget_headphones" android:scaleType="fitCenter"
            android:padding="8dp" android:contentDescription="@string/widget_listen" />
        <ImageButton android:id="@+id/widget_love" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_button" android:src="@drawable/ic_widget_love_outline" android:scaleType="fitCenter"
            android:padding="8dp" android:contentDescription="@string/widget_love" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_button" android:src="@drawable/ic_widget_next" android:scaleType="fitCenter"
            android:padding="8dp" android:contentDescription="@string/widget_next" />
</LinearLayout>
